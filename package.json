{
  "name": "cortecho",
  "version": "0.1.0",
  "private": true,
  "description": "The brain for a rooted Amazon Echo Dot: an ESPHome voice assistant with speech-to-text, an LLM agent with tools and text-to-speech — OpenAI or ElevenLabs per audio stage. No Home Assistant needed.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aformusatii/cortecho.git"
  },
  "homepage": "https://github.com/aformusatii/cortecho#readme",
  "keywords": [
    "voice-assistant",
    "echo-dot",
    "amazon-echo",
    "alexa-alternative",
    "smart-speaker",
    "esphome",
    "esphome-api",
    "openai",
    "openai-whisper",
    "elevenlabs",
    "elevenlabs-text-to-speech",
    "elevenlabs-scribe",
    "llm",
    "ai-agent",
    "speech-to-text",
    "text-to-speech",
    "voice-pipeline",
    "diy",
    "self-hosted",
    "smart-home",
    "home-automation",
    "nodejs",
    "typescript",
    "docker"
  ],
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "cortecho": "./bin/cortecho.mjs"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @cortecho/api\" \"npm run dev -w @cortecho/web\"",
    "build": "npm run build -w @cortecho/web",
    "start": "NODE_ENV=production node apps/api/src/server.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p e2e && tsc --noEmit -p smoke && tsc --noEmit -p onboarding",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:onboarding": "bash onboarding/scripts/run.sh",
    "test:integration": "bash onboarding/scripts/run.sh",
    "test:smoke": "vitest run -c smoke/vitest.smoke.config.ts",
    "smoke:init": "node smoke/init.ts",
    "doctor": "node apps/api/src/scripts/doctor.ts",
    "db:generate": "npm run db:generate -w @cortecho/api",
    "db:migrate": "npm run db:migrate -w @cortecho/api",
    "db:studio": "npm run db:studio -w @cortecho/api",
    "icons": "npm run icons -w @cortecho/web",
    "fake-echo": "npm run fake-echo -w @cortecho/api --",
    "echo-set-key": "npm run echo-set-key -w @cortecho/api --"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild": true
  }
}
