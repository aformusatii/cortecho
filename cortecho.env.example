# Cortecho configuration. Copy this file to `cortecho.env` and fill it in.
#
# READ THE THREE LAYERS in docs/configuration.md:
#   1. the values in "First start only" are imported into SQLite once
#   2. the values in "Read every start" stay in the environment
#   3. every other behaviour setting is edited in the web UI (Settings / Echos)
#
# After the first start, changing a value from group 1 does nothing (the app
# warns at startup). Change it in the UI instead.

# --- First start only: the Echo (imported once) -----------------------------
# The Echo's LAN address. Only one Echo is imported; add more in the UI.
ECHO_HOST=192.168.1.50
ECHO_PORT=26053
# 32-byte base64 key. Leave empty for a plaintext link.
# Generate and install one with:
#   npm run echo-set-key -- --host 192.168.1.50 --env-file cortecho.env
ECHO_API_KEY=

# --- First start only: OpenAI and language (imported once) ------------------
# The key is stored write-only in data/app.db after the import.
OPENAI_API_KEY=
# Comma-separated ISO-639-1 hints; empty = detect automatically.
STT_LANGUAGES=en
TTS_VOICE=marin
# IANA zone. It also sets the container clock.
TZ=UTC

# --- Read every start: this app as the Echo reaches it ----------------------
# The Docker host's LAN address and published port. Never a public URL, and
# never a login page: the Echo downloads the reply with a plain HTTP request.
REPLY_AUDIO_BASE_URL=http://192.168.1.10:3000

# --- Read every start: an OpenAI-compatible server (optional) ---------------
# Must implement the Responses API, streaming speech and audio transcription.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Read every start: tools (optional) -------------------------------------
# See docs/configuration.md. JSON in an env var is easy to break with quoting;
# prefer TOOLS_FILE with a mounted tools.json.
# TOOL_TIMEOUT_MS=8000
# TOOLS_ALLOW_DESTRUCTIVE=
# HTTP_TOOL_ENDPOINTS={"weather":{"url":"http://192.168.1.10:8006/weather","description":"Current outdoor weather"}}
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=
# HOME_ASSISTANT_ALLOWED_SERVICES=light.turn_on,light.turn_off
# SHELL_TOOL_SCRIPTS={"backup_status":{"path":"/app/scripts/backup-status.sh","description":"Last backup result"}}
# TOOLS_FILE=/app/tools.json

# --- Read every start: server (usually leave these) -------------------------
# LOG_LEVEL=info
# DEBUG_AUDIO_DIR=/app/data/audio
# DEBUG_AUDIO_KEEP=20
