# Production smoke tests (specs/production-smoke-tests.md). Copy to
# smoke/.env.smoke with `npm run smoke:init`, which fills in the generated
# identity (API key, node name, MAC). Add your own SMOKE_OPENAI_API_KEY by hand.

# --- Cortecho (production, as seen from code-server) -------------------------
SMOKE_CORTECHO_URL=http://192.168.100.3:8063
SMOKE_CORTECHO_CONTAINER=cortecho

# --- The suite's own OpenAI key: TTS of the requests, transcription of replies.
SMOKE_OPENAI_API_KEY=
# Optional: an OpenAI-compatible base URL (defaults to api.openai.com).
# SMOKE_OPENAI_BASE_URL=

# --- The owner's simulated voice (check current model names before changing) --
SMOKE_TTS_MODEL=gpt-4o-mini-tts
SMOKE_TTS_VOICE=nova
# SMOKE_TTS_INSTRUCTIONS=
SMOKE_TRANSCRIBE_MODEL=gpt-4o-transcribe

# --- The simulated Echo's identity (generated by `npm run smoke:init`) --------
SMOKE_ECHO_BIND=0.0.0.0
SMOKE_ECHO_HOST=code-server
SMOKE_ECHO_PORT=26099
SMOKE_ECHO_API_KEY=
SMOKE_ECHO_NODE_NAME=
SMOKE_ECHO_MAC=
SMOKE_ECHO_WAKE_WORD=Computer
SMOKE_DEVICE_NAME=Test Echo
# Whose per-Echo prompt and overrides are copied onto the Test Echo. Default:
# the other enabled Echo.
# SMOKE_MIRROR_DEVICE=

# --- Mic levels (room calibrated 2026-11-19 from the real Echo's follow-up audio: ~-60 dBFS) ---
SMOKE_SPEECH_DBFS=-26
SMOKE_ROOM_DBFS=-60

# --- Guards -------------------------------------------------------------------
# Stop the run after this many voice turns (cost), unless SMOKE_YES=1.
SMOKE_MAX_TURNS=20
# SMOKE_YES=1          lift the cost guard
# SMOKE_FORCE=1        lift the run lock (another run in progress)

# --- Mail verification/cleanup (spec §6.4). Unset = reported, not run. --------
# SMOKE_MAIL_*         chosen in M4; see docs/development.md
