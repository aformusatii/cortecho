# Development settings for `npm run dev`. Copy to .env (gitignored).
#
# The runtime has three configuration layers (docs/configuration.md):
#  - behaviour settings live in SQLite and are edited in the web UI;
#  - the values under "imported once" below only seed a FRESH database;
#  - everything else is environment-only and read on every start.
# For Docker, use cortecho.env.example instead.

# --- Server -----------------------------------------------------------------
DATABASE_PATH=./data/app.db
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Docker compose (deployment only) ---------------------------------------
# APP_PORT=3000
# DATA_DIR=./data

# --- Read every start: reply audio ------------------------------------------
# This app as the Echo reaches it on the LAN (never a public URL). Empty = the
# address of the Echo link + PORT, which is fine for localhost development and
# wrong inside Docker.
REPLY_AUDIO_BASE_URL=
REPLY_AUDIO_TTL_MS=120000

# --- Read every start: an OpenAI-compatible server (optional) ---------------
# Must implement the Responses API, streaming speech and audio transcription.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Read every start: tools ------------------------------------------------
# See docs/configuration.md for each one.
# TOOL_TIMEOUT_MS=8000
# TOOLS_ALLOW_DESTRUCTIVE=
# TOOLS_ENABLE_ECHO=true
# HTTP_TOOL_ENDPOINTS={"weather":{"url":"http://192.168.1.10:8006/weather","description":"Current outdoor weather"}}
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=
# HOME_ASSISTANT_ALLOWED_SERVICES=light.turn_on,light.turn_off
# SHELL_TOOL_SCRIPTS={"backup_status":{"path":"/app/scripts/backup-status.sh","description":"Last backup result"}}
# TOOLS_FILE=/app/tools.json

# --- Read every start: debug (opt-in) ---------------------------------------
# saves what you say as WAV
# DEBUG_AUDIO_DIR=./data/audio
# DEBUG_AUDIO_KEEP=20

# --- Imported once, on a fresh database (then edit in the UI) ---------------
# For a first start without Docker. Afterwards these are ignored, with a
# warning at startup. See the full list in docs/configuration.md.
# ECHO_HOST=192.168.1.50
# ECHO_PORT=26053
# ECHO_API_KEY=
# OPENAI_API_KEY=
# STT_LANGUAGES=en
# TTS_VOICE=marin
# TZ=UTC
